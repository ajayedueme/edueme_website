/* Modern GPU-friendly card hover animations
   Targets project-specific card classes and provides
   a subtle, smooth lift + shadow using only transform/opacity.
*/
/* Base card styles for smoother transforms and better performance */
.card, .fss-card, .three-card-1, .n-three-card-1, .fss-3-card, .blog-card-1, .courses-box-1, .c-three-card-1 {
    transition: transform .28s cubic-bezier(0.215, 0.61, 0.355, 1), box-shadow .28s cubic-bezier(0.215, 0.61, 0.355, 1), opacity .2s ease;
    will-change: transform, box-shadow, opacity;
    backface-visibility: hidden;
    transform: translateZ(0);
    border-radius: 10px;
}

/* Ensure inner content respects rounded corners when present */
.card .card-inner, .fss-card .card-inner, .three-card-1 .card-inner, .fss-3-card .card-inner {
    overflow: hidden;
    border-radius: inherit;
}

/* Neutral default shadow to reduce layout shift */
.card, .fss-card, .three-card-1, .n-three-card-1 {
    box-shadow: 0 6px 18px rgba(8,15,25,0.06);
    border: 0;
}

/* Apply hover effects only on devices that support hover to avoid touch surprises */
@media (hover: hover) and (pointer: fine) {
    .card:hover, .fss-card:hover, .three-card-1:hover, .n-three-card-1:hover, .fss-3-card:hover, .blog-card-1:hover, .courses-box-1:hover, .c-three-card-1:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 22px 50px rgba(46, 218, 176, 0.12);
        opacity: 1;
    }
}

/* Keyboard accessibility: visible focus state */
.card:focus-visible, .fss-card:focus-visible, .three-card-1:focus-visible, .n-three-card-1:focus-visible {
    outline: 3px solid rgba(46, 218, 176, 0.18);
    outline-offset: 4px;
}

/* Specific rules for featured-services cards to ensure layout & hover work as expected */
.fss-2-subsection { display: flex; gap: 24px; align-items: flex-start; }
.fss-2-subsection .fss-2-1 { display: grid; grid-template-columns: 1fr; gap: 20px; width: 45%; box-sizing: border-box; }

.fss-card {
    display: block;
    width: 100%;
    padding: 22px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 6px 18px rgba(8,15,25,0.06);
    transition: transform .28s cubic-bezier(0.215,0.61,0.355,1), box-shadow .28s cubic-bezier(0.215,0.61,0.355,1), opacity .2s ease;
    will-change: transform, box-shadow, opacity;
    cursor: default;
}

@media (hover: hover) and (pointer: fine) {
    .fss-card:hover {
        transform: translateY(-8px) scale(1.015);
        box-shadow: 0 22px 50px rgba(46, 218, 176, 0.12);
    }
}

/* Ensure images inside the card don't overflow and keep consistent sizing */
.fss-card img { display: block; max-width: 56px; height: auto; margin-bottom: 12px; }

/* Small screens: stack the two card columns into a single column */
@media screen and (max-width: 830px) {
    .fss-2-subsection { flex-direction: column; padding-left: 0; }
    .fss-2-subsection .fss-2-1 { width: 100%; }
}

/* Stronger, higher-specificity card-as-button styles so these rules win
   even when other CSS exists. Uses only transform & box-shadow for GPU
   hardware-accelerated animation. */
.feautred-services-bg .fss-2-subsection .fss-card {
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform .26s cubic-bezier(.22,.8,.28,1), box-shadow .26s cubic-bezier(.22,.8,.28,1), opacity .15s ease;
    will-change: transform, box-shadow, opacity;
    border-radius: 12px;
}

@media (hover: hover) and (pointer: fine) {
    .feautred-services-bg .fss-2-subsection .fss-card:hover {
        transform: translateY(-12px) scale(1.035) !important;
        box-shadow: 0 30px 80px rgba(46,218,176,0.14) !important;
        opacity: 1 !important;
    }
    .feautred-services-bg .fss-2-subsection .fss-card:active {
        transform: translateY(-3px) scale(.995) !important;
        box-shadow: 0 12px 30px rgba(8,15,25,0.08) !important;
    }
}

/* Make sure focus is visible for keyboard users */
.feautred-services-bg .fss-2-subsection .fss-card:focus {
    outline: none;
    box-shadow: 0 30px 80px rgba(46,218,176,0.10), 0 0 0 4px rgba(46,218,176,0.06);
}





