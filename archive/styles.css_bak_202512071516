 -moz-box-shadow: 0px 0px 10px 0px rgba(238,238,252,1);
 box-shadow: 0px 0px 10px 0px rgba(238,238,252,1); padding: 20px; margin: 0px 0px 40px 0px}

/* Responsive grid for the four featured service cards */
.feautred-services-bg .fss-2-subsection {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    align-items: start;
}

/* Flatten wrapper so cards become grid items (the markup nests .fss-2-1 wrappers)
   display: contents lets the .fss-card elements participate in the grid. */
.feautred-services-bg .fss-2-subsection .fss-2-1 {
    display: contents;
}

/* Base card style (GPU-friendly transforms only) */
.feautred-services-bg .fss-card,
.feautred-services-bg .fss-2-subsection .fss-card {
    background: #fff;
    border-radius: 12px;
    padding: 22px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    transition: transform .28s cubic-bezier(0.22,1,0.36,1), box-shadow .28s cubic-bezier(0.22,1,0.36,1), background .28s ease;
    transform: translateY(0);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* Icon, title and link basic transition state */
.feautred-services-bg .fss-card img { transition: transform .28s ease, opacity .28s ease; transform: translateY(0); opacity: 0.98; }
.feautred-services-bg .fss-card h4 { transition: transform .28s ease, color .28s ease; transform: translateY(0); color: #111; }
.feautred-services-bg .fss-card .link-2 { transition: transform .22s ease, opacity .22s ease; display:inline-block; }

/* Hover - only on pointer devices */
@media (hover: hover) and (pointer: fine) {
    .feautred-services-bg .fss-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 18px 32px rgba(0,0,0,0.14);
        background: rgba(30,102,255,0.03);
    }

    /* Icon lifts slightly */
    .feautred-services-bg .fss-card:hover img { transform: translateY(-4px); opacity: 1; }

    /* Title color + slight lift */
    .feautred-services-bg .fss-card:hover h4 { color: #1e66ff; transform: translateY(-2px); }

    /* Read more slides right a bit */
    .feautred-services-bg .fss-card:hover .link-2 { transform: translateX(4px); }
}

/* Ensure no layout jitter: don't change margin on hover */
.feautred-services-bg .fss-card { margin: 0; }

/* Small-screen fallback: single column */
@media screen and (max-width: 767px) {
    .feautred-services-bg .fss-2-subsection { grid-template-columns: 1fr; }
    .feautred-services-bg .fss-card { padding: 18px; }
}

/* New: feature-card interactive styles (adapted to existing markup) */
.feautred-services-bg .fss-card.feature-card,
.feature-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
        transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1),
        background 0.25s ease;
}

/* subtle radial glow */
.feautred-services-bg .fss-card.feature-card::before,
.feature-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(30,102,255,0.12), transparent 60%);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
}

/* icon/title/read-more transitions adapted to current markup */
.feautred-services-bg .fss-card.feature-card img,
.feature-card img { margin-bottom: 14px; transition: transform 0.25s cubic-bezier(0.22,1,0.36,1); }
.feautred-services-bg .fss-card.feature-card h4,
.feature-card h4 { transition: color 0.25s ease, transform 0.25s ease; }
.feautred-services-bg .fss-card.feature-card p,
.feature-card p { transition: opacity 0.25s ease; }
.feautred-services-bg .fss-card.feature-card .link-2,
.feature-card .link-2 { font-weight: 600; display: inline-flex; align-items: center; gap: 6px; transition: color 0.25s ease, transform 0.25s ease; }

/* Hover/interaction (high specificity to override legacy rules) */
@media (hover: hover) and (pointer: fine) {
    .feautred-services-bg .fss-card.feature-card:hover,
    .feature-card:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 22px 40px rgba(15, 23, 42, 0.18);
        background: #ffffff;
    }

    .feautred-services-bg .fss-card.feature-card:hover::before,
    .feature-card:hover::before { opacity: 1; }

    .feautred-services-bg .fss-card.feature-card:hover img,
    .feature-card:hover img { transform: translateY(-4px); }

    .feautred-services-bg .fss-card.feature-card:hover h4,
    .feature-card:hover h4 { color: #1e66ff; transform: translateY(-2px); }

    .feautred-services-bg .fss-card.feature-card:hover p,
    .feature-card:hover p { opacity: 0.95; }

    .feautred-services-bg .fss-card.feature-card:hover .link-2,
    .feature-card:hover .link-2 { color: #1e66ff; transform: translateX(4px); }
}

/* Ensure legacy .fss-card:hover rules don't win for non-feature cards: only reset legacy hover on cards that are NOT .feature-card */
.feautred-services-bg .fss-card:not(.feature-card):hover { transform: none; box-shadow: none; }

/* Strongest override block placed at file end to ensure animations apply. */
.feautred-services-bg .fss-card.feature-card {
    will-change: transform, box-shadow, opacity;
    -webkit-transform: translateZ(0);
}

@media (hover: hover) and (pointer: fine) {
    .feautred-services-bg .fss-card.feature-card:hover,
    .feature-card:hover {
        transform: translateY(-14px) scale(1.03) !important;
        box-shadow: 0 36px 80px rgba(15,23,42,0.2) !important;
    }
    .feautred-services-bg .fss-card.feature-card:hover img,
    .feature-card:hover img { transform: translateY(-6px) !important; }
    .feautred-services-bg .fss-card.feature-card:hover h4,
    .feature-card:hover h4 { color: #1e66ff !important; transform: translateY(-3px) !important; }
    .feautred-services-bg .fss-card.feature-card:hover .link-2,
    .feature-card:hover .link-2 { transform: translateX(6px) !important; color: #1e66ff !important; }
}




