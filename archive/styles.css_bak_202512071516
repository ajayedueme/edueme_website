/* Responsive grid for feature / info cards
     Replaces older flex + percentage-width approach and provides
     a consistent 3 / 2 / 1 column layout across pages.
*/
.three-card-main,
.n-three-card-main,
.three-card-main.grid,
.n-three-card-main.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
}

/* Ensure the existing card blocks behave as grid items and
     don't carry fixed percentage widths from older rules. */
.three-card-main .three-card-1,
.n-three-card-main .n-three-card-1,
.three-card-main .fss-card,
.n-three-card-main .fss-card,
.three-card-main .c-three-card-1,
.n-three-card-main .c-three-card-1,
.three-card-1,
.n-three-card-1,
.fss-card,
.c-three-card-1 {
    width: auto;
    margin: 0;
    box-sizing: border-box;
}

