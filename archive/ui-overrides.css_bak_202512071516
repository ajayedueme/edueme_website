/* Central theme overrides for Edueme (buttons, spacing, nav, hero, cards) */
:root{
  --brand:#0b6b4f;
  --muted:#6b7280;
  --bg:#f6fbfb;
  --card:#ffffff;
  --radius:12px;
  --container:1200px;
}
*{box-sizing:border-box}
body{
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial;
  color:#062425;
  background:var(--bg);
  margin:0;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:1.5;
}
.wrapper{max-width:var(--container);margin:0 auto;padding:0 20px}

/* Header / stacking */
.edueme-header{position:relative;z-index:40}
.edueme-header header{padding:18px 0;background:transparent}
.tz-t1{display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo-div{max-height:56px;display:block}

/* Nav - ensure overrides beat older styles */
.nav-main{display:flex;align-items:center;gap:12px;position:relative;z-index:50}
.nav-main nav{background:transparent !important;box-shadow:none !important;border:none !important}
.nav-main nav ul{display:flex;gap:14px;align-items:center;margin:0;padding:0;list-style:none}
.nav-main nav a{
  display:inline-flex;align-items:center;padding:8px 14px;border-radius:999px;
  color:rgba(6,36,34,0.95);text-decoration:none;font-weight:600;transition:all .15s;
  background:transparent !important;border:0 !important;
}
/* Make .nav-main hover/active match the site rounded style (avoid square overrides) */
.nav-main nav a:hover,
.nav-main nav a:focus {
  background:#ffb600 !important;
  color:#111 !important;
  padding:6px 14px !important;
  border-radius:8px !important;
  box-shadow:0 6px 12px rgba(0,0,0,0.08) !important;
  transform:translateY(-1px);
  text-decoration:none !important;
}

/* Active / CTA styles - align with central nav rules */
.nav-main nav a.active{
  background:#ffb600 !important;
  color:#111 !important;
  padding:6px 14px !important;
  border-radius:8px !important;
  box-shadow:0 4px 8px rgba(0,0,0,0.08) !important;
  font-weight:600 !important;
}
.nav-main nav a.active-2,
.nav-main nav a.shop-now,
.nav-main nav a[href*="Shop"]{
  /* Shop CTA: blue rounded button */
  background:#1e66ff !important;
  color:#fff !important;
  box-shadow:0 6px 14px rgba(30,102,255,0.12) !important;
  padding:6px 18px !important;
  border-radius:10px !important;
  font-weight:700 !important;
}

/* Mobile toggle */
.nav-toggle{display:none;border:0;background:#fff;padding:8px;border-radius:10px;box-shadow:0 6px 18px rgba(2,12,12,0.06);cursor:pointer}
.nav-toggle .fa{font-size:18px;color:var(--brand)}
@media (max-width:900px){
  .nav-toggle{display:inline-flex}
  .nav-main nav{position:fixed;right:12px;top:68px;min-width:260px;background:var(--card);border-radius:12px;padding:12px;box-shadow:0 18px 60px rgba(6,16,20,0.12);transform:translateY(-6px);opacity:0;visibility:hidden;transition:all .18s}
  .nav-main nav.open{transform:translateY(0);opacity:1;visibility:visible}
  .nav-main nav ul{flex-direction:column;gap:10px}
}

/* Hero / carousel: avoid forcing an orange overlay from older theme */
.carousel-inner .carousel-item,
.banner-img-1,
.banner-img-1 .bi-1,
.banner-img-1 .bc-1{
  background:transparent !important;
  color:inherit;
}
.banner-img-1{display:grid;grid-template-columns:1fr 420px;gap:32px;align-items:center;padding:48px 0}
@media (max-width:920px){ .banner-img-1{grid-template-columns:1fr;gap:18px;padding:28px 0} }
@media (max-width:768px){ .banner-img-1{grid-template-columns:1fr;gap:12px;padding:24px 0;order:1} }

/* Left column: text and buttons container */
.bc-1{
  display:flex;
  flex-direction:column;
  justify-content:flex-start;
  align-items:flex-start;
  width:100%;
}

.bc-1 h3{font-size:2.2rem;margin:0 0 10px;color:#04261f}
.bc-1 p{color:var(--muted);max-width:620px;margin-bottom:16px}

/* Hero image */
.bi-1{display:flex;align-items:center;justify-content:center}
.bi-1 img{max-width:100%;height:auto;border-radius:14px;box-shadow:0 20px 60px rgba(3,20,20,0.06)}

/* Buttons (pill + elevated) */
.button-2, .green-color{
  display:inline-block;padding:12px 18px;border-radius:999px;font-weight:700;text-decoration:none;transition:transform .18s,box-shadow .18s;
}
.green-color{background:var(--brand);color:#fff;box-shadow:0 14px 30px rgba(11,107,79,0.12)}
.button-2{background:#fff;color:var(--brand);border:1px solid rgba(11,107,79,0.08)}
.button-2:hover,.green-color:hover{transform:translateY(-4px);box-shadow:0 22px 40px rgba(11,107,79,0.14)}

/* Cards */
.fss-card{background:var(--card);padding:16px;border-radius:12px;box-shadow:0 10px 30px rgba(12,30,30,0.04);transition:transform .28s cubic-bezier(0.22, 1, 0.36, 1);will-change:transform,opacity}
.fss-card img{max-width:64px;margin-bottom:8px;transition:transform .32s cubic-bezier(0.22, 1, 0.36, 1),opacity .32s ease}
/* remove legacy hover here; modern hover handled in styles.css to centralize card animations */
/* .fss-card:hover{transform:translateY(-6px)} */

/* Layout grids */
.three-card-main{display:flex;gap:20px;flex-wrap:wrap}
.three-card-1{flex:1 1 300px;padding:18px;border-radius:12px;background:var(--card);box-shadow:0 8px 26px rgba(6,16,20,0.04)}

/* Forms */
.form-main{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0}
.input-1, .text-area-1{padding:12px;border-radius:10px;border:1px solid #e6eef0;background:#fff;min-width:0}

/* Testimonials */
.testimonial-box{background:rgba(255,255,255,0.95);padding:18px;border-radius:12px;box-shadow:0 12px 36px rgba(4,18,20,0.06)}

/* Footer */
.footer-sec-2{padding:36px 0 18px;background:linear-gradient(180deg,#04241f,#032017);color:#e6f7f3}
.copy-right{background:#021812;color:#9ee4d0;padding:12px;text-align:center;font-size:14px}

/* Hero CTA Buttons - modern styling with smooth hover effects & touch optimizations */
.hero-btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: 11px;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  border: none;
  cursor: pointer;
  margin-right: 14px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  font-size: 15px;
  letter-spacing: 0.3px;
  will-change: transform, box-shadow, background;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
  touch-action: manipulation;
  -webkit-user-select: none;
  user-select: none;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.hero-btn:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);
}

.hero-btn:active {
  transform: translateY(-1px) scale(1.02);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
}

.btn-contact {
  background: #00c48c;
  color: #fff;
}

.btn-contact:hover {
  background: #00a570;
  color: #fff;
  text-decoration: none;
}

.btn-contact:active {
  background: #008b5c;
}

.btn-demo {
  background: #0b1d39;
  color: #fff;
}

.btn-demo:hover {
  background: #162a4d;
  color: #fff;
  text-decoration: none;
}

.btn-demo:active {
  background: #0a1525;
}

/* Responsive button spacing on smaller screens - TOUCH OPTIMIZED FOR MOBILE */
@media (max-width: 640px) {
  .hero-btn {
    display: block;
    margin-right: 0;
    margin-bottom: 12px;
    width: 100%;
    text-align: center;
    min-height: 52px;
    padding: 14px 24px;
  }
  
  .hero-btn:last-child {
    margin-bottom: 0;
  }
  
  /* Touch optimizations for all interactive button classes */
  .button-2,
  .green-color,
  .btn-contact,
  .btn-demo {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    touch-action: manipulation;
    -webkit-user-select: none;
    user-select: none;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
  }
  
  /* Ensure nav links are touch-friendly on mobile */
  .nav-main nav a {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    touch-action: manipulation;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 10px 16px;
  }
  
  /* Touch-friendly card links and buttons */
  .fss-card,
  .three-card-1 {
    -webkit-tap-highlight-color: transparent;
  }
  
  .fss-card a,
  .three-card-1 a,
  .testimonial-box a {
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0);
    touch-action: manipulation;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
}

/* Small scoped hero CTA alignment helper to keep hero CTAs consistent
   across raw file:// views and http views. Apply `.hero-cta-fix` to the
   wrapper around hero buttons (e.g. the `.bc-1` buttons container). */
.hero-cta-fix{
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:14px;
  flex-wrap:wrap;
}
.hero-cta-fix .hero-btn{
  min-width:160px;
  padding:12px 22px;
}
@media (max-width:640px){
  .hero-cta-fix{flex-direction:column;align-items:stretch}
  .hero-cta-fix .hero-btn{width:100%;min-width:0}
}

/* Utilities */
.text-center-1{text-align:center}
.small-muted{color:var(--muted);font-size:.95rem}
